{% import 'macros/ui.html.twig' as ui %}
{% set h = page.header %}
<section class="section section-vm">
    <div class="container">
        {% if h.title %}{{ ui.heading(h.title, h.eyebrow, h.lead) }}{% endif %}
        <div class="vm-grid">
            {% for p in h.panels %}
            <article class="vm-card">
                <span class="vm-icon">{{ ui.icon(p.icon|default('landmark')) }}</span>
                <h3>{{ p.title }}</h3>
                <p>{{ p.text }}</p>
            </article>
            {% endfor %}
        </div>
    </div>
</section>
