{% import 'macros/ui.html.twig' as ui %}
{% set h = page.header %}
<section class="cta">
    <div class="container cta-inner">
        <div>
            <h2>{{ h.title }}</h2>
            {% if h.text %}<p>{{ h.text }}</p>{% endif %}
        </div>
        <div class="cta-actions">
            {% if h.button_label and h.button_url %}<a class="btn btn-light" href="{{ h.button_url }}">{{ h.button_label }} {{ ui.icon('arrow') }}</a>{% endif %}
            {% if h.button2_label and h.button2_url %}<a class="btn btn-outline-light" href="{{ h.button2_url }}">{{ h.button2_label }}</a>{% endif %}
        </div>
    </div>
</section>
