{% import 'macros/ui.html.twig' as ui %}
{% set h = page.header %}
{% set img = h.image ? page.media[h.image] : page.media.images|first %}
<section class="section section-intro">
    <div class="container intro-grid{{ img ? '' : ' no-image' }}">
        <div class="intro-copy">
            {% if h.eyebrow %}<span class="eyebrow">{{ h.eyebrow }}</span>{% endif %}
            {% if h.title %}<h2>{{ h.title }}</h2>{% endif %}
            <div class="prose">{{ page.content|raw }}</div>
            {% if h.button_label and h.button_url %}
            <p><a class="btn" href="{{ h.button_url }}">{{ h.button_label }} {{ ui.icon('arrow') }}</a></p>
            {% endif %}
        </div>
        {% if img %}
        <figure class="intro-media">
            {{ img.quality(82).html(h.title ?: '', '', '')|raw }}
        </figure>
        {% endif %}
    </div>
</section>
